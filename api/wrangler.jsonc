{
  "name": "soundly-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Local dev uses wrangler's built-in D1/R2 simulation. Replace database_id after `wrangler d1 create soundly`.
  "d1_databases": [
    { "binding": "DB", "database_name": "soundly", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "SONGS", "bucket_name": "soundly-songs" }],
  "vars": {
    // DEV_AUTH lets you act as a seeded user via the X-Dev-User header. It must be "false" in production
    // (the `deploy` script forces that). Real sign-in arrives in Phase 3.
    "DEV_AUTH": "true",
    "ALLOWED_ORIGIN": "http://127.0.0.1:5173,http://localhost:5173"
  }
}
